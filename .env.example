SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Portal routing (production hostname mode) ---
# Set BOTH to the two subdomains that front the same service. When set, the
# app routes by hostname instead of by port (8000/8001). Leave blank locally.
#   ERP_HOST=admin.yourdomain.com
#   STORE_HOST=shop.yourdomain.com
ERP_HOST=
STORE_HOST=
# HTTPS origins allowed to POST (Django 4 requirement). Comma-separated, with scheme:
#   CSRF_TRUSTED_ORIGINS=https://admin.yourdomain.com,https://shop.yourdomain.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---
# PaaS (Railway/Render/Heroku): set DATABASE_URL and the POSTGRES_* below are ignored.
#   DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=
# Local + docker-compose (Docker overrides POSTGRES_HOST to "db"):
POSTGRES_DB=erp_core
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery (Docker: URLs are overridden to redis://redis:... by docker-compose) ---
# PaaS: point both at your managed Redis, e.g. CELERY_BROKER_URL=${REDIS_URL}
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@erp.local
